{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "http-server": {
      "root": "apps/http-server",
      "framework": "express",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm --filter @repo/db db:generate && pnpm --filter http-server build"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm --filter @repo/db db:generate && pnpm --filter web build",
      "bindings": [
        {
          "type": "service",
          "service": "http-server",
          "format": "url",
          "env": "HTTP_SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "http-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
