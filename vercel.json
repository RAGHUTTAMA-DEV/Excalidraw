{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "http-server": {
      "root": "apps/http-server",
      "framework": "express"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "http-server",
          "format": "url",
          "env": "HTTP_SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "http-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
